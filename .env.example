VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server only: professional Open-Meteo subscription for waypoint wind/swell forecasts.
# Server weather: public Météo-France MFWAM needs no API key or paid subscription.
SEA_OPERATION_WEATHER_PROVIDER=meteo-france
# Optional provider open-meteo requires its professional key. Never prefix with VITE_.
OPEN_METEO_API_KEY=
VITE_APP_BASE_URL=https://sea-pilot-ten.vercel.app
VITE_PLANNING_ASSISTANT_ENABLED=false
VITE_PLANNING_PREDICTIONS_ENABLED=false

# Optional public Google OAuth Web client ID for the Gmail unread counter.
# The Gmail shortcut works without it. Never place a client secret here.
VITE_GMAIL_CLIENT_ID=

# Server/maintenance credentials only. Never prefix these variables with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only daily official observation collection. Use a strong random value in Vercel Production.
# Météo-France and Met Office public marine observations do not require a weather API key.
CRON_SECRET=
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Expense email: configure these only in Supabase Edge Function Secrets.
# Do not put a Google account password here; use a Google app password.
NDF_EMAIL_USER=
NDF_EMAIL_APP_PASSWORD=
NDF_EMAIL_TO=
