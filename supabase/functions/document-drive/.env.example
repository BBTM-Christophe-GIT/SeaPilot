# SERVER-ONLY. Never prefix these with VITE_ or expose them to the browser.
# Preferred Supabase server configuration: short Google tokens issued through
# Vercel production OIDC and Google Workload Identity Federation. No JSON key.
GOOGLE_DRIVE_TOKEN_BROKER_URL=https://sea-pilot-ten.vercel.app/api/google-drive-token
# Generate 32 random bytes, encoded as hex64 or base64url43. Same secret in
# Supabase and the Vercel production environment; never a VITE_ variable.
GOOGLE_DRIVE_TOKEN_BROKER_SECRET=

# Alternative only where service-account key creation is already permitted.
# JSON on ONE line; client_email needs Reader on the SeaPilot My Drive folder.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Generate a random server secret with at least 32 characters for short links.
GOOGLE_DRIVE_SIGNING_SECRET=

# Optional alternative to a service account: all three OAuth values are needed.
# The account must already have access to the SeaPilot folder.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Optional additional application origins, comma-separated; exact HTTPS URLs.
SEAPILOT_ALLOWED_ORIGINS=

# VERCEL PRODUCTION SERVER ONLY (not required in Supabase):
# GOOGLE_DRIVE_TOKEN_BROKER_SECRET=<same server secret as above>
# GCP_PROJECT_NUMBER=<numeric project number from Google Cloud>
# GCP_WORKLOAD_IDENTITY_POOL_ID=seapilot-production
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# GCP_SERVICE_ACCOUNT_EMAIL=seapilot-documents-reader@seapilot-documents.iam.gserviceaccount.com
# VERCEL_ENV is supplied by Vercel; the broker requires production.
