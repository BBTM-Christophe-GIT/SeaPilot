{
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm build",
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/documents.ts": { "regions": ["cdg1"] },
    "api/sea-operation-weather.ts": { "regions": ["cdg1"], "includeFiles": "node_modules/.pnpm/@meri-imperiumi+eccodes-wasm@2.48.2/node_modules/@meri-imperiumi/eccodes-wasm/**" }
  },
  "headers": [
    {
      "source": "/vessels/bbtm/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/preview/projects",
      "destination": "/preview/projects/index.html"
    },
    {
      "source": "/preview/projects/",
      "destination": "/preview/projects/index.html"
    },
    {
      "source": "/preview/projects/index.html",
      "destination": "/preview/projects/index.html"
    },
    {
      "source": "/previews/projects",
      "destination": "/previews/projects.html"
    },
    {
      "source": "/previews/projects.html",
      "destination": "/previews/projects.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
