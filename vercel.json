{
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm build",
  "framework": "vite",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/vessels/bbtm/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/previews/working-time",
      "destination": "/previews/working-time.html"
    },
    {
      "source": "/previews/working-time.html",
      "destination": "/previews/working-time.html"
    },
    {
      "source": "/preview/projects",
      "destination": "/preview/projects/index.html"
    },
    {
      "source": "/preview/projects/",
      "destination": "/preview/projects/index.html"
    },
    {
      "source": "/preview/projects/index.html",
      "destination": "/preview/projects/index.html"
    },
    {
      "source": "/previews/projects",
      "destination": "/previews/projects.html"
    },
    {
      "source": "/previews/projects.html",
      "destination": "/previews/projects.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
